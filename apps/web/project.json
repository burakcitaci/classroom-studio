{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "implicitDependencies": ["contracts"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{workspaceRoot}/dist/web"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/web",
        "browser": "apps/web/src/main.ts",
        "index": "apps/web/src/index.html",
        "tsConfig": "apps/web/tsconfig.json",
        "styles": ["apps/web/src/styles.css"]
      },
      "configurations": {
        "production": { "outputHashing": "all" },
        "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "options": {
        "buildTarget": "web:build:development",
        "host": "127.0.0.1",
        "port": 4200,
        "proxyConfig": "apps/web/proxy.json"
      }
    },
    "lint": { "command": "eslint apps/web" }
  }
}
