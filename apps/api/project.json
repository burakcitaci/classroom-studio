{
  "name": "api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "implicitDependencies": ["contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/api"],
      "options": { "command": "tsc -p apps/api/tsconfig.json" }
    },
    "serve": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "node --env-file-if-exists=.env dist/api/apps/api/src/main.js" }
    },
    "lint": { "command": "eslint apps/api libs/contracts" },
    "test": {
      "dependsOn": ["build"],
      "command": "node --test tests/api.test.mjs tests/ollama-adapters.test.mjs tests/postgres.test.mjs"
    }
  }
}
