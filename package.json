{
  "name": "classroom-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "^24.15.0 || ^26.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"yarn nx serve api\" \"yarn nx serve web\"",
    "start": "node --env-file-if-exists=.env dist/api/apps/api/src/main.js",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx test api",
    "test:browser": "playwright test",
    "test:live": "node --env-file-if-exists=.env scripts/smoke-ollama.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "docx": "9.15.3",
    "express": "^5.1.0",
    "pdf-parse": "2.4.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "saxes": "6.0.0",
    "tslib": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/yauzl": "3.4.0",
    "@typescript-eslint/parser": "8.71.0",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "nx": "24.0.5",
    "postcss": "^8.5.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
